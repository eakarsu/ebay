NODE_ENV=development
DATABASE_URL=postgresql://commerce:replace-me@127.0.0.1:5432/commerce
COMMERCE_JWT_SECRET=replace-with-at-least-32-random-characters
PROVIDER_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://127.0.0.1:5173
PORT=8080
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

PROVIDER_INVENTORY_URL=https://inventory.sandbox.example
PROVIDER_INVENTORY_TOKEN=replace-me
PROVIDER_TAX_URL=https://tax.sandbox.example
PROVIDER_TAX_TOKEN=replace-me
PROVIDER_PAYMENT_URL=https://payment.sandbox.example
PROVIDER_PAYMENT_TOKEN=replace-me
PROVIDER_SHIPPING_URL=https://shipping.sandbox.example
PROVIDER_SHIPPING_TOKEN=replace-me
