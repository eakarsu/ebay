{
  "name": "governed-commerce-orders",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/server.js",
    "api": "node server/server.js",
    "worker": "node server/worker.js",
    "db:migrate": "node server/migrate.js",
    "create-admin": "node server/create-admin.js",
    "db:seed:development": "node server/seed-development.js",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "check:server": "node --check server/*.js server/test/*.js",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run server/test/domain.test.js",
    "test:integration": "vitest run server/test/orders.integration.test.js --no-file-parallelism",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.20",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
